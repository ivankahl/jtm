---
source: crates/jtm-cli/src/shell/tests.rs
expression: text
---
# jtm shell integration for bash. Add to your rc file:
#   eval "$(jtm shell-init bash)"
jtm() {
  case " $* " in
    *" --json "*|*" --help "*|*" -h "*) command '/opt/jtm'\''s/bin/jtm' "$@"; return $? ;;
  esac
  if [ "${1-}" = use ]; then
    shift
    local __jtm_out
    __jtm_out="$(command '/opt/jtm'\''s/bin/jtm' use --shell bash "$@")" || return $?
    eval "$__jtm_out"
  else
    command '/opt/jtm'\''s/bin/jtm' "$@"
  fi
}
_jtm_hook() {
  local __jtm_out
  __jtm_out="$(command '/opt/jtm'\''s/bin/jtm' hook-env --shell bash)" && eval "$__jtm_out"
}
case ";${PROMPT_COMMAND-};" in
  *";_jtm_hook;"*) ;;
  *) PROMPT_COMMAND="_jtm_hook${PROMPT_COMMAND:+;$PROMPT_COMMAND}" ;;
esac
_jtm_hook
